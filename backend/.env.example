# --- Servidor ---
PORT=3000
# Em produção, troque pelo endereço do seu site (ex.: https://meusite.com)
CORS_ORIGIN=*

# --- Google Drive ---
# ID da pasta (o trecho final da URL da pasta no Drive)
DRIVE_FOLDER_ID=

# --- Limites de upload ---
# Tamanho máximo de imagem, em MB
MAX_FILE_SIZE_MB=5
# Tamanho máximo de vídeo, em MB
MAX_VIDEO_SIZE_MB=30
# Duração máxima de vídeo, em segundos
MAX_VIDEO_SECONDS=5

# --- Autenticação com o Google (OAuth2) ---
# Criados em Google Auth Platform > Clientes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado uma vez com: npm run token (começa com 1//)
GOOGLE_REFRESH_TOKEN=